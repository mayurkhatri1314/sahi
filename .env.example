# ── Supabase (database + auth) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only: ingest job, saves API, click tracker

# ── Affiliate networks (free to join) ───────────────────────────────
CUELINKS_API_KEY=                 # secret: used only to read the offer feed
CUELINKS_CHANNEL_ID=              # public: goes into shopper-facing redirect links
INRDEALS_PUBLISHER_ID=
INRDEALS_API_KEY=

# ── Amazon Associates (apply after 3 qualifying sales in 180 days) ──
AMAZON_ASSOCIATE_TAG=yourtag-21

# ── Keepa (optional Amazon price-history backfill; check current API pricing) ─
KEEPA_API_KEY=

# ── Coupon feed (LinkMyDeals) ────────────────────────────────────────
COUPON_FEED_API_KEY=

# ── Price-drop alert emails (Resend — free 100/day) ─────────────────
RESEND_API_KEY=
ALERT_FROM_DOMAIN=sahi.deals      # domain verified in Resend

# ── App URL (used in alert email links) ─────────────────────────────
NEXT_PUBLIC_APP_URL=https://sahi.deals

# ── Cron security (required: the ingest endpoint refuses to run without it) ─
CRON_SECRET=

# With no keys set, the app shows clearly-labelled sample products and makes no price claims.
